{
  "manifest_version": 3,
  "name": "Focus Flow",
  "version": "1.0.0",
  "description": "Temporizador de concentración y descanso con una animación generativa en p5.js.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_title": "Focus Flow",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-flow@example.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
